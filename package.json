{
  "name": "despega",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm local:setup && pnpm -r --parallel --filter @despega/web --filter @despega/admin dev",
    "dev:web": "pnpm local:setup && pnpm --filter @despega/web dev",
    "dev:admin": "pnpm local:setup && pnpm --filter @despega/admin dev",
    "local:setup": "pnpm --filter @despega/infra local:check",
    "lint": "pnpm -r --filter './apps/*' --if-present lint",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' --filter './infra' --if-present typecheck",
    "test": "pnpm -r --filter './packages/*' --filter './apps/*' --filter './infra' --if-present test",
    "build:web": "pnpm --filter @despega/web build",
    "build:admin": "pnpm --filter @despega/admin build",
    "infra:synth:dev": "pnpm --filter @despega/infra synth:dev",
    "infra:synth:prd": "pnpm --filter @despega/infra synth:prd",
    "infra:bootstrap:dev": "pnpm --filter @despega/infra bootstrap:dev",
    "infra:bootstrap:prd": "pnpm --filter @despega/infra bootstrap:prd",
    "infra:diff:dev": "pnpm --filter @despega/infra diff:dev",
    "infra:diff:prd": "pnpm --filter @despega/infra diff:prd",
    "infra:deploy:dev": "pnpm --filter @despega/infra deploy:dev",
    "infra:deploy:prd": "pnpm --filter @despega/infra deploy:prd"
  }
}
