{
  "name": "@despega/infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cdk": "cdk",
    "synth:dev": "cdk synth --context stage=dev --quiet",
    "synth:prd": "cdk synth --context stage=prd --quiet",
    "bootstrap:dev": "cdk bootstrap --context stage=dev --profile qrioso-dev",
    "bootstrap:prd": "cdk bootstrap --context stage=prd --profile despega-prd",
    "diff:dev": "cdk diff Despega-dev --no-change-set --context stage=dev --profile qrioso-dev",
    "diff:prd": "cdk diff Despega-prd --no-change-set --context stage=prd --profile despega-prd",
    "deploy:dev": "tsx bin/validate-amplify-domains.ts dev && cdk deploy Despega-dev --context stage=dev --profile qrioso-dev",
    "deploy:prd": "tsx bin/validate-amplify-domains.ts prd && cdk deploy Despega-prd --context stage=prd --profile despega-prd",
    "local:check": "tsx bin/check-local-aws.ts",
    "test": "tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@despega/data": "workspace:*",
    "aws-cdk-lib": "2.271.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1141.0",
    "@types/node": "24.19.0",
    "aws-cdk": "2.1143.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
