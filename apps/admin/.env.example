AMPLIFY_MONOREPO_APP_ROOT=apps/admin
AMPLIFY_NEXTJS_EXPERIMENTAL_TRACE=true
STAGE=local
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000

# Identidad del staff: `local` solo con STAGE=local (sin Cognito); `cognito` en dev/prd.
AUTH_PROVIDER=local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Datos: local comparte DynamoDB de qrioso-dev; CDK configura dev/prd.
DATA_REGION=us-east-1
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_CORE=despega_dev_core
DYNAMODB_TABLE_SIMULATION=despega_dev_simulation
