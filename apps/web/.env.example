AMPLIFY_MONOREPO_APP_ROOT=apps/web
AMPLIFY_NEXTJS_EXPERIMENTAL_TRACE=true
STAGE=local
SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Identidad: `local` solo con STAGE=local (sin AWS); `cognito` en dev/prd.
AUTH_PROVIDER=local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Datos: DynamoDB Local en desarrollo; en AWS CDK reemplaza tablas y región.
DATA_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_CORE=despega_local_core
DYNAMODB_TABLE_SIMULATION=despega_local_simulation
